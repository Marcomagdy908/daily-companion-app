// ─── firestore.rules ──────────────────────────────────────────────────
// Daily Companion (رفيق يومي) — Firestore Security Rules
//
// Rules enforce:
//   1. Users can only read/write their own data
//   2. Daily gifts are read-only for authenticated users
//   3. Commitments are user-scoped
//   4. Growth state is user-scoped
//   5. Challenge data is user-scoped
// ────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Check if user is authenticated ─────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Helper: User owns this document ────────────────────────────────
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ── Daily Gifts: Read-only for authenticated users ─────────────────
    match /daily_gifts/{giftId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only via Cloud Functions / Admin SDK
    }

    // ── Commitments: User-scoped CRUD ──────────────────────────────────
    match /commitments/{commitmentId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
                     && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
                     && resource.data.userId == request.auth.uid
                     && request.resource.data.userId == request.auth.uid;
      allow delete: if false; // Commitments are permanent
    }

    // ── Growth States: User-scoped ────────────────────────────────────
    match /growth_states/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    // ── Challenges: User-scoped ───────────────────────────────────────
    match /challenges/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);

      match /days/{dayId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId)
                       // Only allow unlocking the NEXT day
                       && (
                         request.resource.data.isUnlocked == true
                         || request.resource.data.isCompleted == true
                       );
        allow delete: if false;
      }
    }

    // ── Users: Own profile ────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }
  }
}
